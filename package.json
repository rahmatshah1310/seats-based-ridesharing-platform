{
  "name": "our-own-backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx --watch src/bin/seats-based-ridesharing-platform.ts",
    "start": "node dist/bin/seats-based-ridesharing-platform.js",
    "build": "tsc && tsc-alias",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "cross-env DB_MIGRATING=true tsx src/db/migrate.ts",
    "db:seed": "cross-env DB_SEEDING=true tsx src/db/seed.ts"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/debug": "^4.1.12",
    "@types/ejs": "^3.1.5",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.18.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.15.6",
    "cross-env": "^7.0.3",
    "drizzle-kit": "^0.31.7",
    "tsc": "^2.0.4",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.10.5",
    "typescript": "^5"
  },
  "dependencies": {
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "debug": "^4.4.3",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.44.7",
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "express-session": "^1.18.2",
    "joi": "^18.0.2",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.0.2",
    "multer-storage-cloudinary": "^4.0.0",
    "nodemon": "^3.1.11",
    "pg": "^8.16.3",
    "postgres": "^3.4.4"
  }
}
